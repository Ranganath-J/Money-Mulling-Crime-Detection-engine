# AI Service Configuration
APP_NAME=Money-Mulling-AI-Service
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8001
DEBUG=false
LOG_LEVEL=INFO

# Timeout & limits
REQUEST_TIMEOUT_SECONDS=5.0
MAX_BATCH_SIZE=1000

# Model Artifact Locations
MODEL_DIR=app/models/artifacts
TRANSACTION_MODEL_PATH=app/models/artifacts/transaction_classifier.joblib
ANOMALY_MODEL_PATH=app/models/artifacts/anomaly_detector.joblib
GNN_MODEL_PATH=app/models/artifacts/gnn_detector.pt

# Fallback Settings
ALLOW_FALLBACK=true
